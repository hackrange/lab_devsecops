#!/usr/bin/env bash
# Collect everything needed to diagnose a Local Lab problem into one file, with
# every password, token and key removed, so a student can send it to whoever
# is helping them.
#
#   hackrange-lab diag          (or: sudo hackrange-diag)
#
# Writes hackrange-diag-<host>-<time>.tar.gz to the current directory (or /tmp
# when that is not writable) and prints where.  Nothing is sent anywhere.
#
# How secrets are kept out: every secret this lab knows about (the session
# environment, the service passwords, the SAST administrator, the runner's
# registration) is read first, and each one is replaced with [REDACTED] in
# every collected file.  Anything shaped like a token, a password in a URL, or
# a private key is removed as well, in case a log printed one we did not know.
#
# Author: Tim Rice
set -uo pipefail

if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

HR_ROOT=/opt/hackrange-labs
HR_ETC=/etc/hackrange
stamp="$(date +%Y%m%d-%H%M%S)"
name="hackrange-diag-$(hostname -s)-$stamp"
work="$(mktemp -d)"
out="$work/$name"
mkdir -p "$out"
trap 'rm -rf "$work"' EXIT

# cap FILE CMD...  run a command, keep its output, never stop on failure.
cap() {
    local f="$out/$1"; shift
    mkdir -p "$(dirname "$f")"
    { printf '$ %s\n' "$*"; timeout 60 "$@" 2>&1; printf '[exit %s]\n' "$?"; } > "$f"
}

printf 'Collecting Local Lab diagnostics...\n'

# ---- the machine ----------------------------------------------------------------
cap system/os.txt              cat /etc/os-release
cap system/kernel.txt          uname -a
cap system/cpu-memory.txt      sh -c 'nproc; free -h; cat /proc/pressure/memory 2>/dev/null'
cap system/disk.txt            df -h
cap system/uptime.txt          uptime
cap system/virtualization.txt  systemd-detect-virt
cap system/network.txt         sh -c 'ip -4 -brief addr; ip route; grep -E "labgit|labrepo" /etc/hosts'
cap system/listening.txt       ss -ltnp
cap system/dmesg-tail.txt      sh -c 'dmesg -T 2>/dev/null | tail -200'

# ---- the lab's own version and install log ------------------------------------------
cap lab/version.txt       sh -c "git -C $HR_ROOT log -1 --format='%H %cd %s' 2>&1; git -C $HR_ROOT status --short 2>&1"
cap lab/versions.env      cat "$HR_ROOT/versions.env"
cap lab/install-log.txt   sh -c 'tail -n 3000 /var/log/hackrange-install.log'
cap lab/status.txt        sh -c 'hackrange-lab status 2>&1 | sed "s/\x1b\[[0-9;]*m//g"'
# The session environment's NAMES only: which values exist, never what they are.
cap lab/lab-env-keys.txt  sh -c "sed -n 's/=.*/=<set>/p' $HR_ETC/lab.env"
cap lab/lab-conf.txt      cat "$HR_ETC/lab.conf"
cap lab/identity-keys.txt sh -c 'for f in /etc/rancher/lab-identities/*.json; do echo "$f"; python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(sorted(k for k,v in d.items() if v))" "$f"; done'

# ---- services -------------------------------------------------------------------------
for u in hackrange-labnet hackrange-access docker containerd nginx k3s forgejo-runner; do
    cap "services/$u-status.txt"  systemctl status --no-pager "$u"
    cap "services/$u-journal.txt" journalctl -u "$u" --no-pager -n 400
done
cap services/nginx-test.txt       nginx -t
cap services/nginx-error-log.txt  sh -c 'tail -n 300 /var/log/nginx/error.log'
cap services/nginx-stream.txt     sh -c 'ls -la /etc/nginx/stream.d; cat /etc/nginx/stream.d/*.conf'

# ---- Docker and the containers ---------------------------------------------------------
cap docker/version.txt  docker version
cap docker/info.txt     docker info
cap docker/ps.txt       docker ps -a --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'
cap docker/images.txt   docker images
cap docker/disk.txt     docker system df
for c in hackrange-forgejo hackrange-forgerepo hackrange-gcr hackrange-guacd hackrange-guacamole hackrange-lab; do
    cap "docker/$c-inspect-state.txt" docker inspect -f '{{json .State}}' "$c"
    cap "docker/$c-logs.txt"          docker logs --tail 600 "$c"
done
cap docker/ci-job-containers.txt  sh -c "docker ps -a --filter name=FORGEJO-ACTIONS --format '{{.Names}} {{.Status}}'"

# ---- the lab services, from this machine's point of view ------------------------------
for u in https://labgit.lab:8444/api/healthz https://labrepo.lab:8443/ https://10.10.10.70:8445/healthz https://127.0.0.1:8446/guacamole/; do
    cap "reachability/$(echo "$u" | sed 's#https://##; s#[:/]#_#g').txt" curl -sS -o /dev/null -w '%{http_code} %{time_total}s\n' "$u"
done
cap reachability/tls-chain.txt sh -c 'echo | openssl s_client -connect 10.10.10.70:8444 -servername labgit.lab 2>&1 | grep -E "subject=|issuer=|Verify return"'

# ---- Kubernetes ----------------------------------------------------------------------------
K="/usr/local/bin/kubectl --kubeconfig /etc/rancher/k3s/k3s.yaml"
cap k8s/nodes.txt    sh -c "$K get nodes -o wide"
cap k8s/pods.txt     sh -c "$K get pods -A -o wide"
cap k8s/events.txt   sh -c "$K get events -A --sort-by=.lastTimestamp | tail -150"
cap k8s/vcluster.txt sh -c 'KUBECONFIG=/etc/rancher/k3s/k3s.yaml vcluster list'
cap k8s/quota.txt    sh -c "$K get resourcequota,limitrange -A"
cap k8s/registries.txt sh -c 'cat /etc/rancher/k3s/registries.yaml; ls -la /var/lib/rancher/k3s/agent/etc/containerd/certs.d/'

# ---- inside the lab session, if one is running ---------------------------------------------
if [ "$(docker inspect -f '{{.State.Running}}' hackrange-lab 2>/dev/null)" = true ]; then
    cap session/processes.txt docker exec hackrange-lab ps aux
    cap session/hosts.txt     docker exec hackrange-lab cat /etc/hosts
    cap session/reach.txt     docker exec -u student hackrange-lab bash -lc \
        'for u in "$LAB_GIT_URL/api/healthz" "$LAB_REGISTRY_URL/" "$LAB_SAST_URL/healthz" "$LAB_K8S_API/version"; do curl -sS -o /dev/null -w "%{http_code} $u\n" "$u"; done; kubectl get ns 2>&1 | head'
fi

# ---- remove every secret -----------------------------------------------------------------------
# Known secrets, one per line, longest first so a secret that contains another
# is removed whole.
secrets="$work/secrets"
{
    sed -nE 's/^LAB_[A-Z_]*(PASSWORD|TOKEN|TOKEN_APP|TOTP|KUBECONFIG_B64)=//p' "$HR_ETC/lab.env" 2>/dev/null
    sed -n 's/^LAB_ACCESS_PASSWORD=//p' "$HR_ETC/access.env" 2>/dev/null
    cat "$HR_ETC"/secrets/* 2>/dev/null
    cat /etc/rancher/forgejo-admin-password /etc/rancher/forgerepo-admin-password /etc/rancher/gcr-admin 2>/dev/null
    python3 - <<'EOF' 2>/dev/null
import glob, json
for f in glob.glob("/etc/rancher/lab-identities/*.json") + glob.glob("/etc/rancher/lab-identities/_*"):
    try:
        d = json.load(open(f))
    except Exception:
        print(open(f).read().strip()); continue
    for k, v in d.items():
        if not isinstance(v, str) or not v:
            continue
        if k == "kubeconfig":
            # Only the credentials in it, never its ordinary lines.
            import re
            for m in re.finditer(r"(?:client-key-data|client-certificate-data|token):\s*(\S+)", v):
                print(m.group(1))
        elif any(w in k for w in ("password", "token", "secret")) and "\n" not in v:
            print(v)
EOF
    python3 -c "import json; d=json.load(open('/etc/forgejo-runner/.runner')); print(d.get('token','')); print(d.get('uuid',''))" 2>/dev/null
} | awk 'length($0) >= 6' | awk '{ print length($0) "\t" $0 }' | sort -rn | cut -f2- > "$secrets"

SECRETS="$secrets" python3 - "$out" <<'EOF'
import os, re, sys
root = sys.argv[1]
known = [s for s in open(os.environ["SECRETS"]).read().splitlines() if s]
patterns = [
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.S), "[REDACTED PRIVATE KEY]"),
    (re.compile(r"(https?://[^/\s:@]+:)[^@\s/]+@"), r"\1[REDACTED]@"),
    (re.compile(r"\b(nrt|gcr|ghp|gho|github_pat|glpat)_[A-Za-z0-9_-]{8,}"), "[REDACTED TOKEN]"),
    (re.compile(r"(?i)(authorization:\s*(basic|bearer|token)\s+)\S+"), r"\1[REDACTED]"),
    (re.compile(r"(?i)((password|passwd|secret|token)[\"']?\s*[:=]\s*[\"']?)[^\s\"',}]{6,}"), r"\1[REDACTED]"),
]
count = 0
for dirpath, _, files in os.walk(root):
    for name in files:
        p = os.path.join(dirpath, name)
        try:
            text = open(p, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        new = text
        for s in known:
            new = new.replace(s, "[REDACTED]")
        for rx, rep in patterns:
            new = rx.sub(rep, new)
        if new != text:
            count += 1
            open(p, "w", encoding="utf-8").write(new)
print(f"secrets removed from {count} files")
EOF

# A last check: no known secret may survive anywhere in the bundle.
if [ -s "$secrets" ] && grep -rqF -f "$secrets" "$out"; then
    echo "A secret was still found after redaction, so no bundle was written." >&2
    exit 1
fi

dest="$PWD"
[ -w "$dest" ] || dest=/tmp
tar -C "$work" -czf "$dest/$name.tar.gz" "$name"
owner="${SUDO_USER:-root}"
chown "$owner" "$dest/$name.tar.gz" 2>/dev/null || true
printf '\nDiagnostics saved to:  %s/%s.tar.gz\n' "$dest" "$name"
printf 'Passwords, tokens and keys have been removed.  Send that file to whoever is helping you.\n'
