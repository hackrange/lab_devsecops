<?xml version="1.0" encoding="UTF-8"?>
<!--
  Day 7 lab fixture: a project that depends on a SNAPSHOT from a local
  file-based repository (~/safari/snap/repo), so you can watch the bytes
  behind "1.0-SNAPSHOT" change while the version string stays the same.
  Author: Tim Rice
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.lab</groupId>
  <artifactId>snapshot-consumer</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <repositories>
    <repository>
      <id>team-snapshots</id>
      <url>file://${user.home}/safari/snap/repo</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>com.example.team</groupId>
      <artifactId>shared-utils</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>
  </dependencies>
</project>
