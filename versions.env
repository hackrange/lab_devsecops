# Every version the Local Lab installs, in one place.
#
# These match what the hosted course labs run, so a lesson behaves the same on
# a student's own machine as it does in the browser lab.  Change one only on
# purpose, and test the lessons that use it afterward.
#
# Author: Tim Rice

# The Kubernetes distribution behind the student's cluster, and the tool that
# carves the student's own virtual cluster out of it.
K3S_VERSION="v1.36.4+k3s1"
# The k3s install script from that release tag (not get.k3s.io, which changes), checked by SHA-256.
K3S_INSTALL_SHA256="46177d4c99440b4c0311b67233823a8e8a2fc09693f6c89af1a7161e152fbfad"
VCLUSTER_VERSION="0.37.1"

# The lab Git server and the runner that executes the workflows students write.
FORGEJO_IMAGE="codeberg.org/forgejo/forgejo:11"
FORGEJO_RUNNER_VERSION="13.2.0"
RUNNER_JOB_IMAGE="node:24-bookworm"

# The lab package registry (ForgeRepo), built from its public source at the
# commit the hosted labs run.
FORGEREPO_REPO="https://git.hackrange.com/trice/npm-repo.git"
FORGEREPO_REF="51e5a48"
FORGEREPO_IMAGE="lab-forgerepo:latest"

# The SAST and secrets platform (Git Code Review), built from its public source
# plus the three fixes in patches/github-code-review that the hosted labs run.
GCR_REPO="https://git.hackrange.com/trice/github-code-review.git"
GCR_REF="394690b"
GCR_IMAGE="github-code-review:review-1.0.4"

# The web desktop, the way a student opens the lab in a browser.  1.6.0, not
# latest: latest is published for amd64 only, and 1.6.0 has arm64 as well.
GUACAMOLE_IMAGE="guacamole/guacamole:1.6.0"
GUACD_IMAGE="guacamole/guacd:1.6.0"

# The gitleaks release the Day 5 and Day 20 pipelines download as an x86
# program.  On arm64 the installer runs that exact program to prove x86
# emulation works; keep it in step with the lessons.
LESSON_GITLEAKS_VERSION="8.30.1"

# The Week 4 services, always running as lab services (the lessons still
# install their own copies in the student's cluster).  Keycloak 26.4 and Kong
# 3.9 match the lessons.  Every one is published for amd64 and arm64.
KEYCLOAK_IMAGE="quay.io/keycloak/keycloak:26.4"
KONG_IMAGE="kong:3.9"
GRAFANA_IMAGE="grafana/grafana:12.2.0"
LOKI_IMAGE="grafana/loki:3.5.5"
TEMPO_IMAGE="grafana/tempo:2.8.2"

# The student workstation, built on this machine so it trusts this machine's
# own lab certificate authority.
LAB_IMAGE="devsecops-lab:latest"
LAB_GUI_IMAGE="devsecops-lab-gui:latest"
